{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "default",
      "description": "Permissões da janela principal",
      "windows": [
        "main"
      ],
      "permissions": [
        "core:default",
        "autostart:default",
        "dialog:default",
        "fs:default",
        "fs:allow-write-text-file",
        "fs:allow-write-file",
        "clipboard-manager:allow-write-text",
        {
          "identifier": "opener:allow-open-url",
          "allow": [
            {
              "url": "https://*"
            }
          ]
        }
      ]
    },
    {
      "identifier": "overlay",
      "description": "Overlay: lê eventos e esconde a própria janela (mostrar é o comando show_overlay)",
      "windows": [
        "overlay"
      ],
      "permissions": [
        "core:default",
        "core:window:allow-hide"
      ]
    }
  ]
}
